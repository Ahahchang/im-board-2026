rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "uponion129@gmail.com"
        && request.auth.token.email_verified == true;
    }
    // 每份講義一筆：讀書進度、筆記、分類覆寫、標籤、弱點星號
    match /docs/{docId} {
      allow read: if true;
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['status','note','category','tags','stars','updatedAt']);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
